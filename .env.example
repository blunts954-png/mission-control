# Better Stack API Keys
# Get these from: https://betterstack.com -> Settings -> API tokens

# Uptime API - for monitoring website availability
BETTER_STACK_UPTIME_API_KEY=your_uptime_api_key_here

# Telemetry API - for performance metrics
BETTER_STACK_TELEMETRY_API_KEY=your_telemetry_api_key_here

# GitHub Token (optional - for private repos)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Netlify API Token (optional - for deploy status)
# Get from: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_API_TOKEN=your_netlify_token_here
